// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  GOOGLE
  NAVER
  KAKAO
}

model User {
  id String @id @default(cuid())
  provider       OAuthProvider
  providerUserId String
  displayName      String?
  profileImageUrl  String?
  email            String?
  nickname         String?

  // 운영
  status     String   @default("ACTIVE") // ACTIVE | BLOCKED | DELETED 등
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastLoginAt DateTime?

  sessions AuthSession[]
  reviews Review[]
  reviewImages ReviewImage[]
  favorites UserFavorite[]
  reviewComments ReviewComment[]
  reviewLikes ReviewLike[]

  @@unique([provider, providerUserId])
  @@index([provider])
  @@index([createdAt])
  @@index([status])
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  userAgent        String?
  ip               String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

enum DessertCategory {
  saltbread
}

model Shop {
  id String @id @default(cuid())

  // 기본
  dessertCategory DessertCategory
  name           String
  region         String
  roadAddress    String?
  jibunAddress   String?
  telephone      String?
  heroImageUrl   String?
  hoursRaw       String?
  
  // 운영
  query String?
  categoryText String?
  
  // 지도
  latitude  Decimal @db.Decimal(10,7)
  longitude Decimal @db.Decimal(10,7)
  geo Unsupported("geography")?

  // 네이버 연결
  naverPlaceId String? @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links ShopLink[]
  menus ShopMenu[]
  aiBriefing AiBriefing[]
  reviews Review[]
  reviewImages ReviewImage[]
  reviewTags ReviewTag[]
  favorites UserFavorite[]
  @@unique([name, roadAddress])
  @@index([latitude, longitude])
}

model AiBriefing {
  id String @id @default(cuid())
  
  shopId String 
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  content String
  order Int 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, order])
  @@index([shopId])
}

model ShopMenu {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name     String
  price    Int?      
  priceText String? 
  imageUrl String?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, name])
  @@index([shopId])
  @@index([price])
}

model Review {
  id String @id @default(cuid())

  // 관계
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // 작성자(로그인 붙이면 연결)
  authorId String?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // 내용
  rating Int
  content String?
  tags    String[] @default([])

  // 메타
  isHidden Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 연결
  images   ReviewImage[]
  comments ReviewComment[]
  likes    ReviewLike[]

  @@index([shopId, createdAt])
  @@index([shopId, rating])
}

model ReviewComment {
  id       String @id @default(cuid())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId, createdAt])
  @@index([authorId])
}

model ReviewLike {
  id       String @id @default(cuid())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model ReviewTag {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  label String
  count Int
  externalCount Int?

  // 노출/운영
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, label])
}

model ReviewImage {
  id String @id @default(cuid())
  
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  reviewId String
  review   Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  url String
  order Int @default(0)

  createdAt DateTime @default(now())

  @@unique([reviewId, order])
  @@index([reviewId])
  @@index([createdAt])
  @@index([shopId, createdAt])
}

model UserFavorite {
  id     String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
}

model ShopLink {
  id      String @id @default(cuid())
  shopId  String
  type    ShopLinkType
  url     String
  label   String?
  isPrimary Boolean @default(false)

  shop    Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, url])
  @@index([shopId])
}

enum ShopLinkType {
  INSTAGRAM
  YOUTUBE
  NAVER_PLACE
  NAVER_BLOG
  NAVER_SMARTSTORE
  KAKAO
  WEBSITE
  ETC
}
