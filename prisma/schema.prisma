generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DessertCategory {
  saltbread
}

model Shop {
  id              String   @id @default(uuid())
  dessertCategory DessertCategory
  region          String
  query           String
  name            String
  roadAddress     String
  jibunAddress    String
  telephone       String?
  link            String?  
  categoryText    String?  
  longitude       Float
  latitude        Float
  geocodeError    String?  

  status          ShopStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region])
  @@index([name])
  @@index([latitude, longitude])
  @@unique([name, roadAddress, latitude, longitude])
}

enum ShopStatus {
  ACTIVE
  PENDING
  REJECTED
}